{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/src/routeTree.gen.ts",
			"!**/.agents",
			"!**/.claude",
			"!**/skills-lock.json",
			"!**/src/components/ui",
			"!**/src/editors/*/ui",
			"!**/src/editors/*/components",
			"!**/src/editors/*/hooks",
			"!**/src/editors/*/lib",
			"!**/*.css",
			"!**/e2e/.auth"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
